# axum-apm Reverse Proxy Configuration

# Server configuration
PORT=3000

# Upstream server URL (required — the proxy fails to start without it)
UPSTREAM_URL=https://httpbin.org

# Elastic APM configuration
# Note: OTLP/HTTP intake requires APM Server 8.3.0 or newer.
ELASTIC_APM_SERVER_URL=http://localhost:8200
ELASTIC_APM_SERVICE_NAME=axum-reverse-proxy
ELASTIC_APM_SERVICE_VERSION=0.1.0
ELASTIC_APM_ENVIRONMENT=production
# Node name reported to APM (defaults to the system hostname)
# ELASTIC_APM_NODE_NAME=my-node

# Authentication (optional)
# Note: avoid %XX sequences in credentials — the OTLP exporter URL-decodes header values.
# ELASTIC_APM_SECRET_TOKEN=your-secret-token
# ELASTIC_APM_API_KEY=your-api-key

# Transaction sampling (optional)
# Comma-separated list of URL patterns to ignore (supports exact, glob *, and regex patterns)
# ELASTIC_APM_TRANSACTION_IGNORE_URLS=/health,/metrics,^/api/v1/health.*
# Sampling rate 0.0-1.0 (1.0 = sample all transactions, 0.5 = sample 50%)
# ELASTIC_APM_TRANSACTION_SAMPLE_RATE=1.0
