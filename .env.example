# Rust Reverse Proxy Configuration

# Server configuration
PORT=3000

# Upstream server URL
UPSTREAM_URL=https://httpbin.org

# Elastic APM configuration
ELASTIC_APM_SERVER_URL=http://localhost:8200
ELASTIC_APM_SERVICE_NAME=rust-reverse-proxy
ELASTIC_APM_SERVICE_VERSION=0.1.0
ELASTIC_APM_ENVIRONMENT=production
ELASTIC_APM_NODE_NAME=my-node

# Authentication (optional)
# ELASTIC_APM_SECRET_TOKEN=your-secret-token
# ELASTIC_APM_API_KEY=your-api-key